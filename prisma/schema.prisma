datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Admin
  Doctor
  Nurse
  Receptionist
}

enum AccountStatus {
  Active
  Inactive
}

model User {
  id        String        @id @default(uuid())
  name      String
  email     String        @unique
  password  String
  role      Role          @default(Receptionist)
  status    AccountStatus @default(Active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("users")
}

model Patient {
  id                    String   @id @default(uuid())
  registrationType      String
  uhid                  String   @unique
  title                 String
  firstName             String
  middleName            String?
  lastName              String?
  fullName              String
  gender                String
  maritalStatus         String?
  dob                   DateTime?
  age                   Int?
  guardianName          String
  guardianRelation      String?
  regDate               DateTime @default(now())
  mobile                String
  address               String
  country               String   @default("India")
  state                 String
  districtCity          String?
  area                  String?
  pinCode               String?
  altPhone              String?
  email                 String?
  emergencyName         String?
  emergencyRelationship String?
  emergencyContact      String?
  nationality           String   @default("Indian")
  aadhaarCard           String?
  panNo                 String?
  payerType             String
  payer                 String?
  sponsor               String?
  provider              String?
  leadSource            String?
  referredType          String?
  referredBy            String?
  hcf                   String?
  status                String   @default("Active")
  remarks               String?
  religion              String?
  occupation            String?
  isVip                 Boolean  @default(false)
  isAnimation           Boolean  @default(false)
  nameMasking           Boolean  @default(false)
  handleWithCare        Boolean  @default(false)
  sendPromoSms          Boolean  @default(false)
  sendPromoEmail        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([firstName])
  @@index([lastName])
  @@index([fullName])
  @@index([mobile])
  @@index([aadhaarCard])
  @@map("patients")
}

model Invoice {
  id           String   @id @default(uuid())
  company      String
  uhid         String
  patientName  String
  encNo        String
  type         String   // "OP" | "IP"
  invoiceNo    String   @unique
  date         DateTime
  netAmt       Float
  paidPatient  Float    @default(0)
  paidPayer    Float    @default(0)
  adjusted     Float    @default(0)
  refund       Float    @default(0)
  creditNote   Float    @default(0)
  balance      Float
  status       String   // "Outstanding" | "Settled" | "Refundable"
  tdsAmt       Float    @default(0)
  isCancelled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  receipts     Receipt[]

  @@map("invoices")
}

model Receipt {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  mode            String   // "Cash" | "Card" | "UPI" | "Cheque"
  amount          Float
  bankName        String?
  beneficiaryName String?
  refNo           String?
  type            String   @default("Settlement") // "Settlement" | "Refund" | "CreditNote" | "TDS"
  notes           String?
  createdAt       DateTime @default(now())

  @@map("receipts")
}

